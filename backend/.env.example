# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by Git - never commit real passwords.

# --- MySQL connection (required) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=modelbench_db
DATABASE_USER=your_mysql_username
DATABASE_PASSWORD=your_mysql_password

# --- Test database used by pytest (must be a SEPARATE database whose name contains "test") ---
TEST_DATABASE_NAME=modelbench_test_db

# --- Optional settings (defaults shown) ---
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Authentication: use a unique random secret of at least 32 characters.
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
